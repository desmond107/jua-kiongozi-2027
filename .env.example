# ─────────────────────────────────────────────────────────────────────────────
# Jua Kiongozi '27 — environment configuration
#
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# Generate each secret with:  openssl rand -base64 48
# ─────────────────────────────────────────────────────────────────────────────

# PostgreSQL connection string (Neon / Supabase / local Postgres).
# On Neon this is the POOLED endpoint — the hostname containing `-pooler`.
# Serverless opens one connection per invocation, and Postgres runs out of those
# long before Vercel runs out of lambdas.
DATABASE_URL="postgresql://user:password@localhost:5432/jua_kiongozi?schema=public"

# Unpooled connection, used ONLY by `prisma migrate` and `prisma db seed`.
# Migrations take a session-level advisory lock that a transaction-mode pooler
# does not reliably hold, so running them through the pooler can hang.
# On Neon: the same URL with `-pooler` removed from the hostname.
# Anywhere without a pooler (local, RDS): identical to DATABASE_URL.
# REQUIRED — Prisma fails with P1012 at build time if this is unset.
DIRECT_URL="postgresql://user:password@localhost:5432/jua_kiongozi?schema=public"

# Signs the HTTP-only session cookie. Rotating this logs everyone out.
JWT_SECRET=""

# Server-side pepper for hashing voting tokens (HMAC-SHA256).
# Rotating this invalidates every voting token ever issued. Treat as permanent.
TOKEN_HASH_SECRET=""

# AES-256 key that keeps voting tokens retrievable by their owner.
# Unlike the peppers above this one is REVERSIBLE by design — it is what lets a
# citizen see their own token again after registration. Store it separately from
# the database: whoever holds both can read every token and vote as anyone.
# Rotating it does NOT break voting; it only makes existing tokens permanently
# unretrievable (they fall back to the older shown-once behaviour).
# Must decode to exactly 32 bytes:  openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=""

# Server-side pepper for hashing national ID numbers and phone numbers.
# Rotating this breaks duplicate-registration detection AND locks out every
# existing account. Treat as permanent.
IDENTITY_HASH_SECRET=""

# Public site URL, used for absolute links and QR code payloads.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ─── SMS delivery (REQUIRED in production) ───────────────────────────────────
# Registration is gated on a one-time code sent to the citizen's phone. That
# code is the only thing making a fake account cost anything, so production
# refuses to start a registration without a provider configured.
#
#   unset / "console"  → development only; the code is printed to the server log
#   "africastalking"   → real delivery; requires the two keys below
SMS_PROVIDER=""
AT_API_KEY=""
AT_USERNAME=""
# Optional alphanumeric sender ID, if you have one registered.
AT_SENDER_ID=""

# ─── Proxy trust (REQUIRED if not on Vercel) ─────────────────────────────────
# Number of reverse proxies in front of this app. Rate limiting reads the client
# IP this many entries from the RIGHT of X-Forwarded-For, because that header is
# append-only and anything further left was supplied by the caller.
#
# Leave UNSET on Vercel — the platform provides a trustworthy IP directly.
# Set to 1 behind a single nginx/Cloudflare hop, 2 behind two, and so on.
# Guessing high lets clients spoof; guessing low buckets everyone behind the
# proxy together. Count the hops.
TRUSTED_PROXY_HOPS=""

# ─── Operator console (used only by `npm run admin:create`) ──────────────────
# The console at /admin is reached from the small dot at the left of the footer.
# These two are read ONLY by the credential script; the running app never reads
# them, and the password is never stored — only a bcrypt hash of it, in the
# `admins` table.
#
#   ADMIN_USERNAME=oneterm ADMIN_PASSWORD='...' npm run admin:create
#
# Re-running with the same username rotates that operator's password. Clear
# these from .env once the operator exists — leaving a plaintext password on
# disk gains nothing after the hash is written.
ADMIN_USERNAME=""
ADMIN_PASSWORD=""
